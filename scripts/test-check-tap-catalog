#!/usr/bin/env bash
# Fixture tests for scripts/check-tap-catalog.
set -euo pipefail

resolve_script_path() {
  local source="${BASH_SOURCE[0]}" directory target
  while [[ -L "$source" ]]; do
    directory="$(cd -P "$(dirname "$source")" && pwd)"
    target="$(readlink "$source")"
    [[ "$target" == /* ]] && source="$target" || source="$directory/$target"
  done
  printf '%s\n' "$source"
}
root="$(cd -P "$(dirname "$(resolve_script_path)")/.." && pwd)"
check="$root/scripts/check-tap-catalog"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

fail() {
  echo "test-check-tap-catalog: $1" >&2
  exit 1
}

"$check" >/dev/null || fail "live tap README should satisfy the catalog check"

fixture="$tmp/tap"
mkdir -p "$fixture/Formula" "$fixture/Casks" "$fixture/scripts"
cp "$check" "$fixture/scripts/check-tap-catalog"
chmod +x "$fixture/scripts/check-tap-catalog"
printf '%s\n' 'class Demo < Formula' >"$fixture/Formula/demo.rb"
printf '%s\n' 'cask "app" do' >"$fixture/Casks/app.rb"

formula_entry='- `oldwinter/tap/demo`: demo CLI'
cask_entry='- `--cask oldwinter/tap/app`: demo app'

write_readme() {
  cat >"$fixture/README.md" <<EOF
# Fixture tap

## Install

Install \`oldwinter/tap/demo\` or \`brew install --cask oldwinter/tap/app\`.

## Included Formulae

$1

## Included Casks

$2
EOF
}

expect_failure() {
  local description="$1" diagnostic
  shift
  if "$fixture/scripts/check-tap-catalog" >"$tmp/out" 2>"$tmp/err"; then
    fail "$description should fail"
  fi
  for diagnostic in "$@"; do
    grep -Fq -- "$diagnostic" "$tmp/err" \
      || fail "$description should report: $diagnostic"
  done
}

write_readme "$formula_entry" "$cask_entry"
"$fixture/scripts/check-tap-catalog" >/dev/null || fail "complete README fixture should pass"

write_readme "$formula_entry
$formula_entry" "$cask_entry"
expect_failure 'duplicate formula listing' \
  'Included Formulae duplicate formula: oldwinter/tap/demo'

write_readme "$formula_entry" "$cask_entry
$cask_entry"
expect_failure 'duplicate cask listing' \
  'Included Casks duplicate cask: --cask oldwinter/tap/app'

write_readme '' "$cask_entry"
expect_failure 'missing formula listing with surviving install example' \
  'Included Formulae missing formula: oldwinter/tap/demo'

write_readme "$formula_entry" ''
expect_failure 'missing cask listing with surviving install example' \
  'Included Casks missing cask: --cask oldwinter/tap/app'

write_readme "$cask_entry" "$formula_entry"
expect_failure 'listings in the wrong sections' \
  'Included Formulae missing formula: oldwinter/tap/demo' \
  'Included Casks missing cask: --cask oldwinter/tap/app'

write_readme '- `oldwinter/tap/demo-extra`: different formula' "$cask_entry"
expect_failure 'formula prefix collision' \
  'Included Formulae missing formula: oldwinter/tap/demo' \
  'Included Formulae stale formula: oldwinter/tap/demo-extra'

write_readme "$formula_entry" '- `--cask oldwinter/tap/app-extra`: different cask'
expect_failure 'cask prefix collision' \
  'Included Casks missing cask: --cask oldwinter/tap/app' \
  'Included Casks stale cask: --cask oldwinter/tap/app-extra'

mv "$fixture/Casks/app.rb" "$fixture/Casks/demo.rb"
printf '%s\n' 'cask "demo" do' >"$fixture/Casks/demo.rb"
write_readme '' '- `--cask oldwinter/tap/demo`: same-named cask'
expect_failure 'same-named cask without a formula listing' \
  'Included Formulae missing formula: oldwinter/tap/demo'
write_readme "$formula_entry" ''
expect_failure 'same-named formula without a cask listing' \
  'Included Casks missing cask: --cask oldwinter/tap/demo'
write_readme "$formula_entry" '- `--cask oldwinter/tap/demo`: same-named cask'
"$fixture/scripts/check-tap-catalog" >/dev/null || fail "separate same-named listings should pass"
mv "$fixture/Casks/demo.rb" "$fixture/Casks/app.rb"
printf '%s\n' 'cask "app" do' >"$fixture/Casks/app.rb"

write_readme "$formula_entry" "$cask_entry"
mv "$fixture/Formula/demo.rb" "$tmp/demo.rb"
expect_failure 'deleted formula still listed' \
  'Included Formulae stale formula: oldwinter/tap/demo'
mv "$tmp/demo.rb" "$fixture/Formula/demo.rb"
mv "$fixture/Casks/app.rb" "$tmp/app.rb"
expect_failure 'deleted cask still listed' \
  'Included Casks stale cask: --cask oldwinter/tap/app'
mv "$tmp/app.rb" "$fixture/Casks/app.rb"

# A later section and fenced examples must not count as Included entries.
write_readme '' ''
cat >>"$fixture/README.md" <<EOF

\`\`\`markdown
$cask_entry
\`\`\`

## Examples

$formula_entry
$cask_entry
EOF
expect_failure 'listings outside Included sections or inside code fences' \
  'Included Formulae missing formula: oldwinter/tap/demo' \
  'Included Casks missing cask: --cask oldwinter/tap/app'

cat >"$fixture/README.md" <<EOF
# Fixture tap

## Included Formulae

\`\`\`\`markdown
\`\`\`
$formula_entry
\`\`\`\`

## Included Casks

$cask_entry
EOF
expect_failure 'formula listing inside a four-backtick fence' \
  'Included Formulae missing formula: oldwinter/tap/demo'

write_readme "$formula_entry" "$cask_entry"
printf '%s\n' 'class Other < Formula' >"$fixture/Formula/demo.rb"
expect_failure 'formula declaration mismatch' \
  'Formula/demo.rb must declare exactly Demo'
printf '%s\n' 'class Demo < Formula' >"$fixture/Formula/demo.rb"
printf '%s\n' 'cask "other" do' >"$fixture/Casks/app.rb"
expect_failure 'cask declaration mismatch' \
  'Casks/app.rb must declare exactly app'
printf '%s\n' 'cask "app" do' >"$fixture/Casks/app.rb"

printf '%s\n' '#!/usr/bin/env bash' 'echo demo' >"$fixture/scripts/demo"
chmod 0644 "$fixture/scripts/demo"
expect_failure 'non-executable shebang script' \
  'shebang script is not executable: scripts/demo'
rm "$fixture/scripts/demo"

printf '%s\n' '# empty catalog' >"$fixture/README.md"
expect_failure 'empty README' \
  'Included Formulae missing formula: oldwinter/tap/demo' \
  'Included Casks missing cask: --cask oldwinter/tap/app'

rm "$fixture/README.md"
expect_failure 'missing README' 'missing README.md'

write_readme "$formula_entry" "$cask_entry"
for directory in Formula Casks; do
  mv "$fixture/$directory" "$tmp/$directory"
  expect_failure "missing $directory directory" "cannot enumerate $directory/"
  touch "$fixture/$directory"
  expect_failure "$directory is not a directory" "cannot enumerate $directory/"
  rm "$fixture/$directory"
  mv "$tmp/$directory" "$fixture/$directory"
done

# Fail after yielding entries to ensure partial enumeration cannot pass.
mkdir -p "$tmp/bin"
cat >"$tmp/bin/find" <<'EOF'
#!/usr/bin/env bash
printf '%s\0' "$1"/*.rb
echo 'forced find failure' >&2
exit 1
EOF
chmod +x "$tmp/bin/find"
PATH="$tmp/bin:$PATH" expect_failure 'failed directory enumeration' \
  'cannot enumerate Formula/'

mkdir -p "$tmp/links"
ln -s "$check" "$tmp/links/check-tap-catalog"
"$tmp/links/check-tap-catalog" >/dev/null \
  || fail "symlink invocation should validate the source repository"

echo "test-check-tap-catalog: ok"

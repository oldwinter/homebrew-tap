#!/usr/bin/env bash
# Verify README lists every Formula and Cask in this tap.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
readme="$root/README.md"

if [[ ! -f "$readme" ]]; then
  echo "check-tap-catalog: missing README.md" >&2
  exit 1
fi

readme_text="$(<"$readme")"
missing=0

while IFS= read -r -d '' formula; do
  name="$(basename "$formula" .rb)"
  needle="oldwinter/tap/${name}"
  if [[ "$readme_text" != *"$needle"* ]]; then
    echo "check-tap-catalog: README missing formula install: ${needle}" >&2
    missing=1
  fi
done < <(find "$root/Formula" -maxdepth 1 -type f -name '*.rb' -print0 | sort -z)

while IFS= read -r -d '' cask; do
  name="$(basename "$cask" .rb)"
  needle="--cask oldwinter/tap/${name}"
  if [[ "$readme_text" != *"$needle"* ]]; then
    echo "check-tap-catalog: README missing cask install: ${needle}" >&2
    missing=1
  fi
done < <(find "$root/Casks" -maxdepth 1 -type f -name '*.rb' -print0 | sort -z)

if [[ "$missing" -ne 0 ]]; then
  exit 1
fi

echo "check-tap-catalog: README covers every Formula/ and Casks/ entry."

#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version|-v)
      if [[ $# -ne 1 ]]; then
        echo "--version does not accept arguments" >&2
        exit 1
      fi
      echo "${VERSION}"
      exit 0
      ;;
    --help|-h)
      if [[ $# -ne 1 ]]; then
        echo "--help does not accept arguments" >&2
        exit 1
      fi
      cat <<'EOF'
oldwinter-hello: a demo CLI from oldwinter/tap

Usage:
  oldwinter-hello [name...]
  oldwinter-hello --version
  oldwinter-hello --help
EOF
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "unknown option: $1" >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -gt 0 ]]; then
  echo "Hello, $*!"
else
  echo "Hello from oldwinter Homebrew tap!"
fi

#!/usr/bin/env bash
# Round-trip scripts/oldwinter-greet --json output through a stdlib JSON parser.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
greet="$root/scripts/oldwinter-greet"

fail() {
  echo "test-greet-json: $1" >&2
  exit 1
}

command -v python3 >/dev/null 2>&1 || fail "python3 is required to parse JSON"

[[ "$("$greet" world)" == "Hi, world!" ]] || fail "plain greeting should stay unchanged"
[[ "$("$greet" --version)" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "--version should print a version"

GREET="$greet" python3 - <<'PY'
import json
import os
import subprocess
import sys

greet = os.environ["GREET"]
version = subprocess.run(
    [greet, "--version"], capture_output=True, text=True, check=True
).stdout.strip()

cases = [
    ([], "Hi, friend!"),
    (["Ada \"Lovelace\""], 'Hi, Ada "Lovelace"!'),
    ([r"C:\temp"], r"Hi, C:\temp!"),
    (["line1\nline2"], "Hi, line1\nline2!"),
    (["col1\tcol2\bback\ffeed\rret"], "Hi, col1\tcol2\bback\ffeed\rret!"),
    (["Renée 林"], "Hi, Renée 林!"),
    (["Ada", "Lovelace"], "Hi, Ada Lovelace!"),
]

for args, expected in cases:
    proc = subprocess.run([greet, "--json", *args], capture_output=True, text=True)
    if proc.returncode != 0:
        sys.exit(f"test-greet-json: --json {args!r} exited {proc.returncode}")
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        sys.exit(f"test-greet-json: --json {args!r} is invalid JSON: {exc}: {proc.stdout!r}")
    if data.get("message") != expected:
        sys.exit(
            f"test-greet-json: --json {args!r} decoded to {data.get('message')!r},"
            f" expected {expected!r}"
        )
    if data.get("tool") != "oldwinter-greet" or data.get("version") != version:
        sys.exit(f"test-greet-json: --json {args!r} changed the envelope keys: {data!r}")

print("test-greet-json: ok")
PY

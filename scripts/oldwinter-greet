#!/usr/bin/env bash
set -euo pipefail

VERSION="0.2.0"

print_help() {
  cat <<'HELP'
oldwinter-greet: a simple greeting CLI

Usage:
  oldwinter-greet [name...]
  oldwinter-greet --json [name...]
  oldwinter-greet --version
  oldwinter-greet --help
HELP
}

json_escape() {
  local s="$1" escaped="" ch
  local i code
  for ((i = 0; i < ${#s}; i++)); do
    ch="${s:i:1}"
    case "${ch}" in
      '"') escaped+='\"' ;;
      '\') escaped+='\\' ;;
      $'\b') escaped+='\b' ;;
      $'\f') escaped+='\f' ;;
      $'\n') escaped+='\n' ;;
      $'\r') escaped+='\r' ;;
      $'\t') escaped+='\t' ;;
      *)
        printf -v code '%d' "'${ch}"
        if ((code >= 0 && code < 32)); then
          printf -v ch '\\u%04x' "${code}"
        fi
        escaped+="${ch}"
        ;;
    esac
  done
  printf '%s' "${escaped}"
}

as_json=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version|-v)
      echo "${VERSION}"
      exit 0
      ;;
    --help|-h)
      print_help
      exit 0
      ;;
    --json)
      as_json=true
      shift
      break
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "unknown option: $1" >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

name="${*:-friend}"
message="Hi, ${name}!"

if [[ "${as_json}" == "true" ]]; then
  printf '{"tool":"oldwinter-greet","version":"%s","message":"%s"}\n' "${VERSION}" "$(json_escape "${message}")"
else
  echo "${message}"
fi
